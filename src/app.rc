#include <windows.h>
#include "Resource.h"

// Manifest
1 24 "manifest.xml"

// Main Application Icon
IDI_APP_ICON ICON "..\\res\\app.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION 6,42,1,0
PRODUCTVERSION 6,42,1,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tafim Software"
            VALUE "FileDescription", "Tafim Internet Download Manager"
            VALUE "FileVersion", "6.42.1.0"
            VALUE "InternalName", "Tafim"
            VALUE "LegalCopyright", "Copyright (C) 2026 Tafim Software. All rights reserved."
            VALUE "OriginalFilename", "Tafim.exe"
            VALUE "ProductName", "Tafim Internet Download Manager"
            VALUE "ProductVersion", "6.42.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
